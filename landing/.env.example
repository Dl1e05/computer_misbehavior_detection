# Copy this file to .env and fill in your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for /api/stripe/webhook.
# Local testing: run `stripe listen --forward-to localhost:8000/api/stripe/webhook` and paste the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=

# Public address of the site, used for return links from Stripe. Empty = taken from the request.
PUBLIC_BASE_URL=

# AI assistant (DeepSeek). Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Crimetor backend for the assistant's read-only requests, e.g. http://localhost:8080
BACKEND_BASE_URL=
# Optional token for role-protected endpoints. Anyone who can open the site reads that data through the chat.
BACKEND_TOKEN=
