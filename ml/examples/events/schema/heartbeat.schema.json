{
 "$defs": {
  "CameraStatus": {
   "additionalProperties": false,
   "properties": {
    "camera_id": {
     "maxLength": 128,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9._:\\-]+$",
     "title": "Camera Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "online",
      "offline"
     ],
     "title": "Status",
     "type": "string"
    },
    "rules": {
     "additionalProperties": {
      "type": "string"
     },
     "description": "{\"fall\": \"on\", \"fire\": \"off: нет весов ...\"}",
     "title": "Rules",
     "type": "object"
    }
   },
   "required": [
    "camera_id",
    "status"
   ],
   "title": "CameraStatus",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "Статус узла: раз в 5 с QoS 0, без retain. Last Will (QoS 1) — status offline без sent_at;\nwill от старого run_id BE игнорирует.",
 "properties": {
  "schema_version": {
   "const": "1.0",
   "default": "1.0",
   "title": "Schema Version",
   "type": "string"
  },
  "node_id": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "title": "Node Id",
   "type": "string"
  },
  "run_id": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "title": "Run Id",
   "type": "string"
  },
  "status": {
   "enum": [
    "online",
    "offline"
   ],
   "title": "Status",
   "type": "string"
  },
  "sent_at": {
   "anyOf": [
    {
     "description": "UTC, ISO 8601 с миллисекундами и Z: 2026-11-21T05:15:32.480Z",
     "format": "date-time",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Sent At"
  },
  "model_version": {
   "anyOf": [
    {
     "maxLength": 128,
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Model Version"
  },
  "cameras": {
   "items": {
    "$ref": "#/$defs/CameraStatus"
   },
   "title": "Cameras",
   "type": "array"
  },
  "dropped_stale": {
   "anyOf": [
    {
     "description": "сколько событий/участников с запуска не отправлено: старше mqtt.max_age_s после долгой недоступности",
     "minimum": 0,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Dropped Stale"
  }
 },
 "required": [
  "schema_version",
  "node_id",
  "run_id",
  "status"
 ],
 "title": "Heartbeat",
 "type": "object"
}