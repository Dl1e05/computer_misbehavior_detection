{
 "additionalProperties": false,
 "description": "Данные лица участника подтверждённого события (топик .../participants).\nsnapshot_quality \"ok\" — есть snapshot_ref, embedding и quality_score; \"no_usable_face\" — нет ни одного из них.\nЛица — только для zone_intrusion, fall и fight/confirmation (никогда для suspicion и новых типов).",
 "properties": {
  "schema_version": {
   "const": "1.0",
   "default": "1.0",
   "title": "Schema Version",
   "type": "string"
  },
  "event_id": {
   "format": "uuid",
   "title": "Event Id",
   "type": "string"
  },
  "camera_id": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "title": "Camera Id",
   "type": "string"
  },
  "track_id": {
   "minimum": 0,
   "title": "Track Id",
   "type": "integer"
  },
  "snapshot_ref": {
   "anyOf": [
    {
     "description": "ключ в хранилище: faces/<camera_id>/<ГГГГММДД UTC>/<event_id>_<track_id>.jpg",
     "maxLength": 512,
     "minLength": 1,
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Snapshot Ref"
  },
  "snapshot_quality": {
   "enum": [
    "ok",
    "no_usable_face"
   ],
   "title": "Snapshot Quality",
   "type": "string"
  },
  "quality_score": {
   "anyOf": [
    {
     "maximum": 1.0,
     "minimum": 0.0,
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Quality Score"
  },
  "embedding": {
   "anyOf": [
    {
     "description": "512 чисел ArcFace, нормирован: длина вектора 1 ± 0.01",
     "items": {
      "type": "number"
     },
     "maxItems": 512,
     "minItems": 512,
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Embedding"
  },
  "embedding_model_version": {
   "maxLength": 128,
   "minLength": 1,
   "title": "Embedding Model Version",
   "type": "string"
  }
 },
 "required": [
  "schema_version",
  "event_id",
  "camera_id",
  "track_id",
  "snapshot_quality",
  "embedding_model_version"
 ],
 "title": "Participant",
 "type": "object"
}