     "minimum": 0,
     "title": "Track Id",
     "type": "integer"
    },
    "bbox": {
     "maxItems": 4,
     "minItems": 4,
     "prefixItems": [
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "title": "Bbox",
     "type": "array"
    },
    "confidence": {
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "Confidence",
     "type": "number"
    }
   },
