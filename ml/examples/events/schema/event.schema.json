  },
  "bbox": {
   "anyOf": [
    {
     "maxItems": 4,
     "minItems": 4,
     "prefixItems": [
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Bbox"
  }
