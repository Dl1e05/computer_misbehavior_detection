{
 "$defs": {
  "AbandonedObjectDetails": {
   "additionalProperties": false,
   "description": "abandoned_object: какой предмет и сколько секунд он без присмотра.",
   "properties": {
    "object_class": {
     "enum": [
      "backpack",
      "handbag",
      "suitcase",
      "laptop",
      "umbrella"
     ],
     "title": "Object Class",
     "type": "string"
    },
    "unattended_s": {
     "minimum": 0,
     "title": "Unattended S",
     "type": "number"
    }
   },
   "required": [
    "object_class",
    "unattended_s"
   ],
   "title": "AbandonedObjectDetails",
   "type": "object"
  },
  "CrowdingDetails": {
   "additionalProperties": false,
   "description": "crowding: сколько людей в зоне на момент события.",
   "properties": {
    "count": {
     "minimum": 1,
     "title": "Count",
     "type": "integer"
    }
   },
   "required": [
    "count"
   ],
   "title": "CrowdingDetails",
   "type": "object"
  },
  "EventParticipant": {
   "additionalProperties": false,
   "properties": {
    "track_id": {
     "description": "целое >= 0; уникален внутри camera_id и run_id",
     "minimum": 0,
     "title": "Track Id",
     "type": "integer"
    },
    "bbox": {
     "description": "[x1, y1, x2, y2] — доли 0–1 от ширины/высоты кадра, начало — левый верхний угол; x1 <= x2, y1 <= y2",
     "maxItems": 4,
     "minItems": 4,
     "prefixItems": [
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      },
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      },
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      },
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      }
     ],
     "title": "Bbox",
     "type": "array"
    },
    "confidence": {
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "Confidence",
     "type": "number"
    }
   },
   "required": [
    "track_id",
    "bbox",
    "confidence"
   ],
   "title": "EventParticipant",
   "type": "object"
  },
  "LineCrossingDetails": {
   "additionalProperties": false,
   "description": "line_crossing: in — слева направо, если смотреть вдоль линии от первой точки ко второй.",
   "properties": {
    "direction": {
     "enum": [
      "in",
      "out"
     ],
     "title": "Direction",
     "type": "string"
    }
   },
   "required": [
    "direction"
   ],
   "title": "LineCrossingDetails",
   "type": "object"
  },
  "LoiteringDetails": {
   "additionalProperties": false,
   "description": "loitering: сколько секунд человек в зоне на момент события.",
   "properties": {
    "dwell_s": {
     "minimum": 0,
     "title": "Dwell S",
     "type": "number"
    }
   },
   "required": [
    "dwell_s"
   ],
   "title": "LoiteringDetails",
   "type": "object"
  },
  "ObjectTakenDetails": {
   "additionalProperties": false,
   "description": "object_taken: какой предмет унесли (сигнал на проверку, не доказательство кражи).",
   "properties": {
    "object_class": {
     "enum": [
      "backpack",
      "handbag",
      "suitcase",
      "laptop",
      "umbrella"
     ],
     "title": "Object Class",
     "type": "string"
    }
   },
   "required": [
    "object_class"
   ],
   "title": "ObjectTakenDetails",
   "type": "object"
  },
  "RunningDetails": {
   "additionalProperties": false,
   "description": "running: скорость в ростах человека в секунду.",
   "properties": {
    "speed": {
     "minimum": 0,
     "title": "Speed",
     "type": "number"
    }
   },
   "required": [
    "speed"
   ],
   "title": "RunningDetails",
   "type": "object"
  },
  "TamperingDetails": {
   "additionalProperties": false,
   "description": "camera_tampering: что случилось с камерой.",
   "properties": {
    "tamper_type": {
     "enum": [
      "covered",
      "moved",
      "defocused",
      "glare"
     ],
     "title": "Tamper Type",
     "type": "string"
    }
   },
   "required": [
    "tamper_type"
   ],
   "title": "TamperingDetails",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "Событие ML. Связи полей (проверяет валидатор ML; BE — по этому описанию):\n- event_type: suspicion/confirmation — только у fight; у остальных — detection;\n- zone_id + zone_version — обязательны у zone_intrusion, loitering, crowding и запрещены у прочих;\n- episode_id — обязателен у fight и запрещён у прочих;\n- bbox — обязателен у fire и smoke (рамка очага), abandoned_object и object_taken (рамка предмета),\n  запрещён у прочих; у fire и smoke participants пустой;\n- participants не пустой у всех, кроме fire, smoke, camera_tampering (пустой) и abandoned_object\n  (может быть пустым: владелец ушёл);\n- schema 1.1 (новые типы): line_id — обязателен у line_crossing; details — по схеме своего типа.",
 "properties": {
  "schema_version": {
   "default": "1.0",
   "enum": [
    "1.0",
    "1.1"
   ],
   "title": "Schema Version",
   "type": "string"
  },
  "event_id": {
   "format": "uuid",
   "title": "Event Id",
   "type": "string"
  },
  "event_type": {
   "enum": [
    "detection",
    "suspicion",
    "confirmation"
   ],
   "title": "Event Type",
   "type": "string"
  },
  "incident_type": {
   "pattern": "^[a-z][a-z0-9_]{1,63}$",
   "title": "Incident Type",
   "type": "string"
  },
  "camera_id": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "title": "Camera Id",
   "type": "string"
  },
  "occurred_at": {
   "description": "UTC, ISO 8601 с миллисекундами и Z: 2026-11-21T05:15:32.480Z",
   "format": "date-time",
   "title": "Occurred At",
   "type": "string"
  },
  "confidence": {
   "maximum": 1.0,
   "minimum": 0.0,
   "title": "Confidence",
   "type": "number"
  },
  "participants": {
   "items": {
    "$ref": "#/$defs/EventParticipant"
   },
   "title": "Participants",
   "type": "array"
  },
  "model_version": {
   "maxLength": 128,
   "minLength": 1,
   "title": "Model Version",
   "type": "string"
  },
  "run_id": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "title": "Run Id",
   "type": "string"
  },
  "zone_id": {
   "anyOf": [
    {
     "description": "UUID зоны из cameras-zones",
     "format": "uuid",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Zone Id"
  },
  "zone_version": {
   "anyOf": [
    {
     "minimum": 0,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Zone Version"
  },
  "episode_id": {
   "anyOf": [
    {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Episode Id"
  },
  "bbox": {
   "anyOf": [
    {
     "description": "[x1, y1, x2, y2] — доли 0–1 от ширины/высоты кадра, начало — левый верхний угол; x1 <= x2, y1 <= y2",
     "maxItems": 4,
     "minItems": 4,
     "prefixItems": [
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      },
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      },
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      },
      {
       "maximum": 1.0,
       "minimum": 0.0,
       "type": "number"
      }
     ],
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Bbox"
  },
  "line_id": {
   "anyOf": [
    {
     "description": "UUID линии из cameras-zones",
     "format": "uuid",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Line Id"
  },
  "details": {
   "anyOf": [
    {
     "$ref": "#/$defs/LineCrossingDetails"
    },
    {
     "$ref": "#/$defs/LoiteringDetails"
    },
    {
     "$ref": "#/$defs/CrowdingDetails"
    },
    {
     "$ref": "#/$defs/RunningDetails"
    },
    {
     "$ref": "#/$defs/TamperingDetails"
    },
    {
     "$ref": "#/$defs/AbandonedObjectDetails"
    },
    {
     "$ref": "#/$defs/ObjectTakenDetails"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Details"
  }
 },
 "required": [
  "schema_version",
  "event_id",
  "event_type",
  "incident_type",
  "camera_id",
  "occurred_at",
  "confidence",
  "participants",
  "model_version",
  "run_id"
 ],
 "title": "Event",
 "type": "object"
}