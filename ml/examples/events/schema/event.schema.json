   "title": "Camera Id",
   "type": "string"
  },
  "occurred_at": {
   "format": "date-time",
   "title": "Occurred At",
   "type": "string"
  },
  "confidence": {
   "maximum": 1.0,
   "minimum": 0.0,
   "title": "Confidence",
   "type": "number"
  },
  "participants": {
   "items": {
    "$ref": "#/$defs/EventParticipant"
   },
   "title": "Participants",
   "type": "array"
  },
  "model_version": {
   "maxLength": 128,
   "minLength": 1,
   "title": "Model Version",
   "type": "string"
  },
  "run_id": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "title": "Run Id",
   "type": "string"
  },
  "zone_id": {
   "anyOf": [
    {
     "maxLength": 128,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9._:\\-]+$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Zone Id"
  },
  "zone_version": {
   "anyOf": [
    {
     "minimum": 0,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Zone Version"
  },
  "episode_id": {
   "anyOf": [
    {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
