    "detection",
    "suspicion",
    "confirmation"
   ],
   "title": "Event Type",
   "type": "string"
  },
  "incident_type": {
   "pattern": "^[a-z][a-z0-9_]{1,63}$",
   "title": "Incident Type",
   "type": "string"
  },
  "camera_id": {
   "maxLength": 128,
   "minLength": 1,
