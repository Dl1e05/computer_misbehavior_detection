# Timers
TIMER_SUSPICION_SECONDS=10
TIMER_ESCALATION_SECONDS=30
REPEAT_WINDOW_SECONDS=60
CLIP_PRE_ROLL_SECONDS=5
CLIP_POST_ROLL_SECONDS=5
CLOCK_SKEW_WARN_SECONDS=2
SIGNED_LINK_TTL_SECONDS=60

# Identification
IDENT_TOP_K=5
IDENT_MATCH_THRESHOLD=
IDENT_MARGIN=

# Event processing
EVENT_ACK_MODE=after_commit

# Database
DB_HOST=
DB_PORT=
DB_NAME=
# Limited app login (no UPDATE/DELETE on the audit). Must differ from
# DB_MIGRATION_USER.
DB_USER=
DB_PASSWORD=
# Schema owner, used only by Alembic. Not needed by the running app.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# MQTT
MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=

# Signing keys
SESSION_SIGNING_KEY=
CLIP_LINK_SIGNING_KEY=
